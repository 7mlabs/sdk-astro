{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:query-request:1.0",
  "title": "Grouped on-demand calculation query",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "longitude"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "geometry"
        },
        "action": {
          "const": "normalize"
        },
        "longitude": {
          "type": "number"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "longitude1",
        "longitude2"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "geometry"
        },
        "action": {
          "const": "separation"
        },
        "longitude1": {
          "type": "number"
        },
        "longitude2": {
          "type": "number"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "longitude1",
        "longitude2"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "geometry"
        },
        "action": {
          "const": "midpoint"
        },
        "longitude1": {
          "type": "number"
        },
        "longitude2": {
          "type": "number"
        },
        "antipodalPolicy": {
          "enum": [
            "error",
            "lowerLongitude"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "positions",
        "rule"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "aspects"
        },
        "action": {
          "const": "between"
        },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/position"
          },
          "maxItems": 2
        },
        "rule": {
          "$ref": "#/$defs/aspectRule"
        },
        "motionMode": {
          "enum": [
            "none",
            "relative",
            "fixedSecond"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "longitude",
        "houseCusps"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "houses"
        },
        "action": {
          "const": "locate"
        },
        "longitude": {
          "type": "number"
        },
        "houseCusps": {
          "type": "array",
          "minItems": 12,
          "items": {
            "type": "number"
          },
          "maxItems": 12
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "birth"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "aspects"
        },
        "action": {
          "const": "inspect"
        },
        "birth": {
          "$ref": "#/$defs/birthInput"
        },
        "rulership": {
          "enum": [
            "traditional",
            "modern"
          ]
        },
        "aspectPreset": {
          "enum": [
            "major",
            "extended"
          ]
        },
        "aspectRules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/aspectRule"
          },
          "maxItems": 16
        },
        "pointIds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto",
              "ascendant",
              "midheaven",
              "descendant",
              "imumCoeli",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7",
              "H8",
              "H9",
              "H10",
              "H11",
              "H12"
            ]
          },
          "maxItems": 26,
          "uniqueItems": true
        }
      },
      "not": {
        "type": "object",
        "properties": {
          "aspectPreset": {},
          "aspectRules": {}
        },
        "required": [
          "aspectPreset",
          "aspectRules"
        ]
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "birth"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "points"
        },
        "action": {
          "const": "inspect"
        },
        "birth": {
          "$ref": "#/$defs/birthInput"
        },
        "rulership": {
          "enum": [
            "traditional",
            "modern"
          ]
        },
        "aspectPreset": {
          "enum": [
            "major",
            "extended"
          ]
        },
        "aspectRules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/aspectRule"
          },
          "maxItems": 16
        },
        "pointIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto",
              "ascendant",
              "midheaven",
              "descendant",
              "imumCoeli",
              "H1",
              "H2",
              "H3",
              "H4",
              "H5",
              "H6",
              "H7",
              "H8",
              "H9",
              "H10",
              "H11",
              "H12"
            ]
          },
          "maxItems": 26,
          "uniqueItems": true
        }
      },
      "not": {
        "type": "object",
        "properties": {
          "aspectPreset": {},
          "aspectRules": {}
        },
        "required": [
          "aspectPreset",
          "aspectRules"
        ]
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "group",
        "action",
        "birth"
      ],
      "properties": {
        "operation": {
          "const": "query"
        },
        "group": {
          "const": "houses"
        },
        "action": {
          "const": "inspect"
        },
        "birth": {
          "$ref": "#/$defs/birthInput"
        },
        "rulership": {
          "enum": [
            "traditional",
            "modern"
          ]
        },
        "aspectPreset": {
          "enum": [
            "major",
            "extended"
          ]
        },
        "aspectRules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "$ref": "#/$defs/aspectRule"
          },
          "maxItems": 16
        },
        "houseNumbers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "maxItems": 12,
          "uniqueItems": true
        }
      },
      "not": {
        "type": "object",
        "properties": {
          "aspectPreset": {},
          "aspectRules": {}
        },
        "required": [
          "aspectPreset",
          "aspectRules"
        ]
      }
    }
  ],
  "$defs": {
    "birthInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc",
        "location"
      ],
      "properties": {
        "utc": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "year",
            "month",
            "day",
            "hour",
            "minute"
          ],
          "properties": {
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2399
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            },
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "second": {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 60,
              "default": 0
            }
          }
        },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "exclusiveMinimum": -90,
              "exclusiveMaximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        },
        "houseSystem": {
          "enum": [
            "placidus",
            "wholeSign"
          ],
          "default": "placidus"
        }
      }
    },
    "aspectRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "angle",
        "maxOrb"
      ],
      "properties": {
        "angle": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "maxOrb": {
          "type": "number",
          "minimum": 0,
          "maximum": 15
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "longitude"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "longitude": {
          "type": "number"
        },
        "speed": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    }
  },
  "$comment": "Core additionally checks finite arithmetic, unique/nonblank position IDs and 128 UTF-8 byte length, valid Gregorian dates, exact raw JSON integer normalization, and ordered house cusps traversing the zodiac once. Optional selectors and options reject null. Inspection selectors default all; aspectPreset defaults major."
}
