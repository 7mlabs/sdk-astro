{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:natal-request:1.0",
  "title": "Basic natal request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "utc",
    "location"
  ],
  "properties": {
    "operation": {
      "const": "natal"
    },
    "utc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2399
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 60,
          "default": 0
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "houseSystem": {
      "enum": [
        "placidus",
        "wholeSign"
      ],
      "default": "placidus"
    },
    "aspectRules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "angle",
          "maxOrb"
        ],
        "properties": {
          "angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "maxOrb": {
            "type": "number",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    }
  },
  "$comment": "Gregorian valid day/month/leap-year and unique aspect angles are enforced by core. Integer-valued decimal/exponent JSON numbers are normalized exactly by core; no rounding or string coercion."
}
