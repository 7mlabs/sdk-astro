{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:events-request:1.0",
  "title": "Bounded global events for a fixed-offset civil day, month or year",
  "description": "Default selects all ten bodies and six event families; major aspects by default. Lunar phases and global eclipses always use Sun/Moon independently of bodies. Core verifies valid calendar dates, exact integer-valued fields, unique aspect angles and UTC half-open window within supported provider range; event budget fails instead of truncating.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "period"
  ],
  "properties": {
    "operation": {
      "const": "events"
    },
    "period": {
      "$ref": "#/$defs/period"
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "sun",
          "moon",
          "mercury",
          "venus",
          "mars",
          "jupiter",
          "saturn",
          "uranus",
          "neptune",
          "pluto"
        ]
      }
    },
    "eventTypes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ingress",
          "station",
          "lunarPhase",
          "planetaryAspect",
          "solarEclipse",
          "lunarEclipse"
        ]
      }
    },
    "aspectPreset": {
      "enum": [
        "major",
        "extended"
      ],
      "default": "major"
    },
    "aspectRules": {
      "$ref": "urn:7mlabs:astrology:natal-domains-request:1.0#/properties/aspectRules"
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "aspectRules",
          "aspectPreset"
        ],
        "type": "object",
        "properties": {
          "aspectRules": {},
          "aspectPreset": {}
        }
      }
    }
  ],
  "$defs": {
    "period": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "day"
            },
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2399
            },
            "utcOffsetMinutes": {
              "type": "integer",
              "minimum": -840,
              "maximum": 840,
              "default": 0
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "day": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31
            }
          },
          "required": [
            "kind",
            "year",
            "month",
            "day"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "month"
            },
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2399
            },
            "utcOffsetMinutes": {
              "type": "integer",
              "minimum": -840,
              "maximum": 840,
              "default": 0
            },
            "month": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            }
          },
          "required": [
            "kind",
            "year",
            "month"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "year"
            },
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2399
            },
            "utcOffsetMinutes": {
              "type": "integer",
              "minimum": -840,
              "maximum": 840,
              "default": 0
            }
          },
          "required": [
            "kind",
            "year"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
