{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:geometry-request:1.0",
  "title": "Geometry request from supplied positions",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "positions"],
  "properties": {
    "operation": { "enum": ["chart", "harmonic", "synastry"] },
    "positions": { "$ref": "#/$defs/positions" },
    "otherPositions": { "anyOf": [{ "$ref": "#/$defs/positions" }, { "type": "null" }] },
    "houses": { "anyOf": [{ "$ref": "#/$defs/houses" }, { "type": "null" }] },
    "otherHouses": { "anyOf": [{ "$ref": "#/$defs/houses" }, { "type": "null" }] },
    "harmonic": { "type": ["integer", "null"], "minimum": 1, "maximum": 360 },
    "aspectRules": {
      "type": "array", "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["angle", "maxOrb"],
        "properties": { "angle": { "type": "number", "minimum": 0, "maximum": 180 }, "maxOrb": { "type": "number", "minimum": 0, "maximum": 15 } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "operation": { "const": "harmonic" } } },
      "then": { "required": ["harmonic"], "properties": { "harmonic": { "type": "integer" }, "houses": { "type": "null" }, "otherHouses": { "type": "null" }, "otherPositions": { "type": "null" } } } },
    { "if": { "properties": { "operation": { "const": "synastry" } } },
      "then": { "required": ["otherPositions"], "properties": { "otherPositions": { "$ref": "#/$defs/positions" }, "harmonic": { "type": "null" } } } },
    { "if": { "properties": { "operation": { "const": "chart" } } },
      "then": { "properties": { "otherPositions": { "type": "null" }, "otherHouses": { "type": "null" }, "harmonic": { "type": "null" } } } }
  ],
  "$defs": {
    "positions": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "longitude"],
        "properties": { "id": { "type": "string", "minLength": 1, "maxLength": 128 }, "longitude": { "type": "number" }, "speed": { "type": ["number", "null"] } }
      }
    },
    "houses": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "number" } }
  },
  "$comment": "Core additionally checks unique/nonblank IDs, 128 UTF-8 byte ID length, one zodiac traversal of house cusps, unique rule angles and finite arithmetic. JSON Schema length counts characters, not UTF-8 bytes."
}
