{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:7mlabs:astrology:natal-domains-request:1.0",
  "title": "Individual natal domain and custom profile request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "utc",
    "location"
  ],
  "properties": {
    "operation": {
      "const": "natalDomains"
    },
    "utc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "month",
        "day",
        "hour",
        "minute"
      ],
      "properties": {
        "year": {
          "type": "integer",
          "minimum": 1800,
          "maximum": 2399
        },
        "month": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "second": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 60,
          "default": 0
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "exclusiveMinimum": -90,
          "exclusiveMaximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "houseSystem": {
      "enum": [
        "placidus",
        "wholeSign"
      ],
      "default": "placidus"
    },
    "aspectRules": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "angle",
          "maxOrb"
        ],
        "properties": {
          "angle": {
            "type": "number",
            "minimum": 0,
            "maximum": 180
          },
          "maxOrb": {
            "type": "number",
            "minimum": 0,
            "maximum": 15
          }
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "enum": [
          "career",
          "love",
          "relationships",
          "family",
          "finance",
          "identity",
          "learning",
          "creativity",
          "innerLife",
          "dailyLife"
        ]
      },
      "description": "Absent selects all ten builtins. Empty requires at least one custom profile."
    },
    "rulership": {
      "enum": [
        "traditional",
        "modern"
      ],
      "default": "traditional"
    },
    "aspectPreset": {
      "enum": [
        "major",
        "extended"
      ]
    },
    "customProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/customProfile"
      },
      "description": "Custom IDs and section IDs must be unique within their scope; core enforces ID uniqueness."
    }
  },
  "$comment": "Gregorian valid day/month/leap-year and unique aspect angles are enforced by core. Integer-valued decimal/exponent JSON numbers are normalized exactly by core; no rounding or string coercion. Profile and section ID uniqueness is enforced by core. Explicit null is not accepted for any option; selector arrays default empty but each profile and section needs at least one selector.",
  "allOf": [
    {
      "not": {
        "required": [
          "aspectRules",
          "aspectPreset"
        ],
        "type": "object",
        "properties": {
          "aspectRules": {},
          "aspectPreset": {}
        }
      }
    },
    {
      "if": {
        "type": "object",
        "required": [
          "domains"
        ],
        "properties": {
          "domains": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "customProfiles"
        ],
        "properties": {
          "customProfiles": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "profileSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]{0,63}$",
          "not": {
            "anyOf": [
              {
                "enum": [
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              },
              {
                "pattern": "[^a-zA-Z0-9_-]"
              }
            ]
          }
        },
        "houses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "maxItems": 12,
          "uniqueItems": true,
          "default": []
        },
        "bodies": {
          "type": "array",
          "items": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ]
          },
          "maxItems": 10,
          "uniqueItems": true,
          "default": []
        },
        "angles": {
          "type": "array",
          "items": {
            "enum": [
              "ascendant",
              "midheaven",
              "descendant",
              "imumCoeli"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true,
          "default": []
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "houses"
          ],
          "properties": {
            "houses": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bodies"
          ],
          "properties": {
            "bodies": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "angles"
          ],
          "properties": {
            "angles": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    },
    "customProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]{0,63}$",
          "not": {
            "anyOf": [
              {
                "enum": [
                  "career",
                  "love",
                  "relationships",
                  "family",
                  "finance",
                  "identity",
                  "learning",
                  "creativity",
                  "innerLife",
                  "dailyLife",
                  "constructor",
                  "prototype",
                  "__proto__"
                ]
              },
              {
                "pattern": "[^a-zA-Z0-9_-]"
              }
            ]
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,31}$",
          "default": "1.0",
          "not": {
            "pattern": "[^a-zA-Z0-9._-]"
          }
        },
        "houses": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "maxItems": 12,
          "uniqueItems": true,
          "default": []
        },
        "bodies": {
          "type": "array",
          "items": {
            "enum": [
              "sun",
              "moon",
              "mercury",
              "venus",
              "mars",
              "jupiter",
              "saturn",
              "uranus",
              "neptune",
              "pluto"
            ]
          },
          "maxItems": 10,
          "uniqueItems": true,
          "default": []
        },
        "angles": {
          "type": "array",
          "items": {
            "enum": [
              "ascendant",
              "midheaven",
              "descendant",
              "imumCoeli"
            ]
          },
          "maxItems": 4,
          "uniqueItems": true,
          "default": []
        },
        "sections": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/profileSection"
          },
          "default": []
        }
      },
      "anyOf": [
        {
          "type": "object",
          "required": [
            "houses"
          ],
          "properties": {
            "houses": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bodies"
          ],
          "properties": {
            "bodies": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "angles"
          ],
          "properties": {
            "angles": {
              "type": "array",
              "minItems": 1
            }
          }
        }
      ]
    }
  }
}
